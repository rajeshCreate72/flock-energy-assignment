{
  "openapi": "3.0.0",
  "info": {
    "title": "Urja Meter Ops API",
    "version": "1.0.0",
    "description": "Clean API wrapper over the Urja Meter Ops portal."
  },
  "paths": {
    "/meters": {
      "get": {
        "summary": "List all meters",
        "responses": {
          "200": {
            "description": "List of meters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Meter" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/meters/filter-meters": {
      "get": {
        "summary": "Filter meters by status, make, or phase",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Installed | Faulty | Decommissioned"
          },
          { "name": "make", "in": "query", "schema": { "type": "string" } },
          {
            "name": "phase",
            "in": "query",
            "schema": { "type": "string", "enum": ["single", "three"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered meters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Meter" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transformers": {
      "get": {
        "summary": "List all distribution transformers",
        "responses": {
          "200": {
            "description": "List of transformers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Transformer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Authenticate this service against the portal (internal/admin use)",
        "responses": {
          "200": { "description": "Login succeeded" },
          "500": { "description": "Login failed" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meter": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNo": { "type": "string", "example": "SE33962" },
          "make": { "type": "string", "example": "HPL" },
          "phaseType": { "type": "string", "enum": ["single", "three"] },
          "installStatus": {
            "type": "string",
            "enum": ["Installed", "Faulty", "Decommissioned"]
          },
          "dtCode": { "type": "string", "example": "DT-001" }
        }
      },
      "Transformer": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "DT-001" },
          "name": { "type": "string", "example": "Malviya Nagar DT 1" },
          "feederCode": { "type": "string", "example": "F-001" },
          "capacityKva": { "type": "number", "example": 100 }
        }
      }
    }
  }
}
